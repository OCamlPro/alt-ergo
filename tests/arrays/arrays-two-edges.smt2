; b = (store a i x) = (store a j y) with i <> j: a and b agree everywhere.
(set-logic QF_AX)
(declare-sort T 0)
(declare-sort E 0)
(declare-const a (Array T E))
(declare-const b (Array T E))
(declare-const i T)
(declare-const j T)
(declare-const x E)
(declare-const y E)
(assert (distinct i j))
(assert (distinct a b))
(assert (= b (store a i x)))
(assert (= b (store a j y)))
(check-sat)
