; The quantifiers of named terms are in prenex position, and the names must
; still be usable in other terms.
(set-option :produce-assignments true)
(set-logic ALL)
(declare-fun G (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(assert (! (forall ((x Int)) (G x)) :named n))
(assert (! (distinct a b c) :named d))
(check-sat)
(get-assignment)
(push 1)
(assert (or (not n) (= a c)))
(check-sat)
(pop 1)
(push 1)
(assert (not (G a)))
(check-sat)
(pop 1)
(push 1)
(define-fun e () Bool (forall ((x Int)) (G (+ x 1))))
(assert e)
(assert (not (G 5)))
(check-sat)
(pop 1)
(assert (not d))
(check-sat)
