; A top-level `distinct` is a single n-ary literal; its negation must never be
; read as "all the arguments are equal" (see issue #889).
(set-logic ALL)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const p Bool)
(push 1)
(assert (distinct a b c))
(assert (= a b))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (= a b))
(assert (= b c))
(check-sat)
(pop 1)
(push 1)
(assert (and p (distinct a b c)))
(assert (or (= a c) (= b c)))
(check-sat)
(pop 1)
(push 1)
(assert (or p (distinct a b c)))
(assert (not p))
(assert (distinct a c))
(check-sat)
(pop 1)
(assert (not (distinct a b c)))
(assert (distinct a b))
(check-sat)
